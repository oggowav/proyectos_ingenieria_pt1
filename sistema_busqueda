    token_freq = Counter()
    token_files = defaultdict(set)
    file_durations = []
    total_collisions = 0
    total_tokens_read = 0
    start_total = time.time()
    for filename in files_to_process:
        path = os.path.join(folder_path, filename)
        start_file = time.time()

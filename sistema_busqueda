                    if len(word) <= 1: 
                        continue
                    if word in stopwords: 
                        continue
                    token_freq[word] += 1
                    token_files[word].add(filename)
        except Exception as e:
            print(f"Error en A9 al procesar {filename}: {e}")
        end_file = time.time()
        file_durations.append((filename, end_file - start_file))

def main():
    """Función principal con menú interactivo"""
    
    if len(sys.argv) >= 2:
        token = sys.argv[1]
        use_stoplist = "--no-stoplist" not in sys.argv
        retrieve(token, use_stoplist)
        return
    
    while True:
        mostrar_menu()
        opcion = input("\nSelecciona una opción (1-5): ").strip()
        
        if opcion == "1":
            ejecutar_actividades_previas()
            input("\nPresiona Enter para continuar...")
            
        elif opcion == "2":
            print("\nGenerando índices invertidos...")
            create_inverted_index_with_options(folder_path, project_folder, use_stoplist=True, min_frequency=3)
            create_inverted_index_with_options(folder_path, project_folder, use_stoplist=False, min_frequency=3)
            print("\n✓ Índices generados exitosamente")
            input("\nPresiona Enter para continuar...")
            
        elif opcion == "3":
            token = input("\nIngresa el token a buscar: ").strip()
            print("\n¿Qué versión usar?")
            print("1. Con stoplist")
            print("2. Sin stoplist")
            print("3. Ambas")
            version = input("Selecciona (1/2/3): ").strip()
            
            if version == "1":
                retrieve(token, use_stoplist=True)
            elif version == "2":
                retrieve(token, use_stoplist=False)
            elif version == "3":
                retrieve(token, use_stoplist=True)
                retrieve(token, use_stoplist=False)
            
            input("\nPresiona Enter para continuar...")
            
        elif opcion == "4":
            test_all_tokens()
            input("\nPresiona Enter para continuar...")
            
        elif opcion == "5":
            print("\n¡Hasta luego!\n")
            break
            
        else:
            print("\n❌ Opción inválida. Intenta de nuevo.")
            input("\nPresiona Enter para continuar...")

if __name__ == "__main__":
    main()
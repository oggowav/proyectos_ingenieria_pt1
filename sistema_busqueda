    output_file = os.path.join(project_folder, f"a9_dictionary.txt")
    with open(output_file, "w", encoding="utf-8") as archivo:
        for i, slot in enumerate(hash_table):
            if not slot:
                archivo.write(f"Posición Hash: {i}, Token: {EMPTY_SLOT_INDICATOR}, Frecuencia: 0, Archivos: 0, Posición Posting: {EMPTY_POSTING_POSITION}\n")
            else:
                for token, freq, num_files, _ in slot:
                    archivo.write(f"Posición Hash: {i}, Token: {token}, Frecuencia: {freq}, Archivos: {num_files}, Posición Posting: {i}\n")
    log_file = os.path.join(project_folder, f"a9_{matricula}.txt")
    with open(log_file, "w", encoding="utf-8") as log:
        for filename, duration in file_durations:
            log.write(f"{filename}           {duration:.4f} \n")
        log.write(f"Tiempo total de ejecucion del programa: {total_time:.4f} segundos\n") 
    return file_durations, total_time, total_collisions, HASH_TABLE_SIZE

def create_inverted_index_with_options(folder_path, project_folder, 
                                       matricula="03038135", 
                                       use_stoplist=True,
                                       min_frequency=3):
    """
    Crea el índice invertido con opciones de filtrado
    """
    suffix = "" if use_stoplist else "_no_stoplist"
    
    print(f"\n{'='*70}")
    print(f"Generando índice invertido {'CON' if use_stoplist else 'SIN'} stoplist")
    print(f"{'='*70}")
    
    files_to_process = sorted([f for f in os.listdir(folder_path) if f.endswith('.html')])
    
    stopwords = set()
    if use_stoplist:
        stoplist_path = os.path.join(project_folder, "Actividad9_stoplist.txt")
        stopwords = load_stoplist(stoplist_path)
    
    log_filename = f"a11_{matricula}{suffix}.txt"
    log_path = os.path.join(project_folder, log_filename)
    
    with open(log_path, "w", encoding="utf-8") as log:
        log.write(f"=== A11 - Generación de Índice Invertido {'CON' if use_stoplist else 'SIN'} Stoplist ===\n")
        log.write(f"Frecuencia mínima: {min_frequency}\n")
        log.write(f"Stoplist activa: {use_stoplist}\n\n")
        
        document_ids = {}
        documents_output = os.path.join(project_folder, f"documents{suffix}.txt")
        
        with open(documents_output, "w", encoding="utf-8") as doc_file:
            start_total = time.time()
            for i, filename in enumerate(files_to_process, start=1):
                start = time.time()
                full_path = os.path.join(folder_path, filename)
                document_ids[filename] = i
                doc_file.write(f"{i} - {filename} - {full_path}\n")
                end = time.time()
                log.write(f"{filename} - {end - start:.4f} segundos\n")
        
        log.write("\n=== Procesando tokens ===\n")
        
        token_doc_freq = defaultdict(lambda: defaultdict(int))
        token_total_freq = Counter()
        
        for filename in files_to_process:
            start = time.time()
            full_path = os.path.join(folder_path, filename)
            
            with open(full_path, "r", encoding="latin-1") as f:
                cleaned = re.sub(r'<.*?>', '', f.read())
                words = extract_words(cleaned)
                
                for w in words:
                    token = w.lower()
                    
                    if len(token) <= 1:
                        continue
                    
                    if use_stoplist and token in stopwords:
                        continue
                    
                    token_doc_freq[token][filename] += 1
                    token_total_freq[token] += 1
            
            end = time.time()
            log.write(f"Tokens de {filename} procesados en {end - start:.4f} segundos\n")
        
        tokens_to_keep = {token for token, freq in token_total_freq.items() 
                         if freq >= min_frequency}
        
        log.write(f"\n=== Estadísticas ===\n")
        log.write(f"Tokens únicos antes de filtro: {len(token_total_freq)}\n")
        log.write(f"Tokens finales en el índice: {len(tokens_to_keep)}\n\n")
        
        log.write("=== Creando Posting y Diccionario ===\n")
        
        posting_output = os.path.join(project_folder, f"posting{suffix}.txt")
        dictionary_output = os.path.join(project_folder, f"dictionary{suffix}.txt")
        
        posting_position = 0
        posting_entries = []
        
        with open(dictionary_output, "w", encoding="utf-8") as dict_file, \
             open(posting_output, "w", encoding="utf-8") as post_file:
            
            for token in sorted(tokens_to_keep):
                docs = token_doc_freq[token]
                total_freq = token_total_freq[token]
                
                start_pos = posting_position
                
                for filename in sorted(docs.keys()):
                    freq = docs[filename]
                    doc_id = document_ids[filename]
                    weight = round(freq / total_freq, 4)
                    posting_entries.append(f"{doc_id} - {weight}")
                    posting_position += 1
                
                dict_file.write(
                    f"token: {token} | freq: {total_freq} | docs: {len(docs)} | posting_pos: {start_pos}\n"
                )
            
            for idx, entry in enumerate(posting_entries):
                post_file.write(f"{idx}:  {entry}\n")
        
        end_total = time.time()
        total_time = end_total - start_total
        
        log.write("\n=== RESUMEN FINAL ===\n")
        log.write(f"Archivos procesados: {len(files_to_process)}\n")
        log.write(f"Tokens en el diccionario: {len(tokens_to_keep)}\n")
        log.write(f"Tiempo total del proceso: {total_time:.4f} segundos\n")
        log.write("="*70 + "\n")
    
    print(f"✓ Índice {'CON' if use_stoplist else 'SIN'} stoplist generado")
    print(f"  - Tokens indexados: {len(tokens_to_keep)}\n")
    
    return log_path

def normalize_token(token):
    """Normaliza el token a minúsculas para búsqueda"""
    return token.lower().strip()

def search_token_in_dictionary(dictionary_path, search_token):
    """Busca un token en el archivo de diccionario"""
    search_token = normalize_token(search_token)
    
    try:
        with open(dictionary_path, 'r', encoding='utf-8') as f:
            for line in f:
                match = re.search(r'token:\s*(\S+)\s*\|\s*freq:\s*(\d+)\s*\|\s*docs:\s*(\d+)\s*\|\s*posting_pos:\s*(\d+)', line)
                if match:
                    token = match.group(1)
                    if token == search_token:
                        return {
                            'token': token,
                            'freq': int(match.group(2)),
                            'docs': int(match.group(3)),
                            'posting_pos': int(match.group(4))
                        }
    except FileNotFoundError:
        print(f"Error: No se encontró el archivo {dictionary_path}")
        return None
    except Exception as e:
        print(f"Error al leer el diccionario: {e}")
        return None
    
    return None

def get_documents_from_posting(posting_path, start_pos, num_docs):
    """Obtiene los documentos del archivo posting"""
    documents = []
    
    try:
        with open(posting_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
            
            for i in range(start_pos, min(start_pos + num_docs, len(lines))):
                match = re.search(r'(\d+):\s*(\d+)\s*-\s*([\d.]+)', lines[i])
                if match:
                    doc_id = int(match.group(2))
                    weight = float(match.group(3))
                    documents.append((doc_id, weight))
    except FileNotFoundError:
        print(f"Error: No se encontró el archivo {posting_path}")
        return []
    except Exception as e:
        print(f"Error al leer posting: {e}")
        return []
    
    return documents

def get_document_names(documents_path, doc_ids):
    """Obtiene los nombres de archivos correspondientes a los doc_ids"""
    doc_map = {}
    
    try:
        with open(documents_path, 'r', encoding='utf-8') as f:
            for line in f:
                match = re.search(r'(\d+)\s*-\s*(\S+)\s*-', line)
                if match:
                    doc_id = int(match.group(1))
                    filename = match.group(2)
                    doc_map[doc_id] = filename
    except FileNotFoundError:
        print(f"Error: No se encontró el archivo {documents_path}")
        return []
    except Exception as e:
        print(f"Error al leer documentos: {e}")
        return []
    
    results = []
    for doc_id, weight in doc_ids:
        if doc_id in doc_map:
            results.append((doc_id, doc_map[doc_id], weight))
    
    results.sort(key=lambda x: x[2], reverse=True)
    return results

def retrieve(search_token, use_stoplist=True):
    """Función principal de búsqueda"""
    
    suffix = "" if use_stoplist else "_no_stoplist"
    
    dictionary_path = os.path.join(project_folder, f"dictionary{suffix}.txt")
    posting_path = os.path.join(project_folder, f"posting{suffix}.txt")
    documents_path = os.path.join(project_folder, f"documents{suffix}.txt")
    
    print(f"\n{'='*60}")
    print(f"Búsqueda del token: '{search_token}'")
    print(f"Usando índice: {'CON' if use_stoplist else 'SIN'} stoplist")
    print(f"{'='*60}\n")
    
    token_info = search_token_in_dictionary(dictionary_path, search_token)
    
    if token_info is None:
        print(f"❌ El token '{search_token}' NO fue encontrado en el diccionario.")
        print(f"   Posibles razones:")
        print(f"   - El token no existe en ningún documento")
        if use_stoplist:
            print(f"   - Fue filtrado por stoplist")
        print(f"   - Tiene frecuencia menor a 3")
        return
    
    print(f"✓ Token encontrado en el diccionario:")
    print(f"  - Frecuencia total: {token_info['freq']}")
    print(f"  - Aparece en {token_info['docs']} documento(s)")
    print(f"  - Posición en posting: {token_info['posting_pos']}\n")
    
    doc_list = get_documents_from_posting(
        posting_path, 
        token_info['posting_pos'], 
        token_info['docs']
    )
    
    if not doc_list:
        print("❌ No se pudieron recuperar los documentos del posting.")
        return
    
    results = get_document_names(documents_path, doc_list)
    
    if not results:
        print("❌ No se pudieron recuperar los nombres de los documentos.")
        return
    
    print(f"📄 Documentos que contienen '{search_token}':\n")
    
    for i, (doc_id, filename, weight) in enumerate(results, 1):
        print(f"{i}. {filename}")
    

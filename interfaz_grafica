    def view_document(self, filename):
        """Abre una ventana para ver el documento completo"""
        filepath = os.path.join(self.search_engine.html_folder, filename)
        
        if not os.path.exists(filepath):
            messagebox.showerror("Error", "No se pudo encontrar el documento.")
            return
        
        # Crear ventana nueva
        doc_window = tk.Toplevel(self.root)
        doc_window.title(f"Documento: {filename}")
        doc_window.geometry("800x600")
        
        # Frame principal
        main_frame = ttk.Frame(doc_window, padding="10")
        main_frame.pack(fill=tk.BOTH, expand=True)
        
        # Título
        title_label = ttk.Label(main_frame,
                               text=filename,
                               font=('Segoe UI', 14, 'bold'))
        title_label.pack(pady=(0, 10))
        
        # Área de texto con scroll
        text_area = scrolledtext.ScrolledText(main_frame,
                                              wrap=tk.WORD,
                                              font=('Consolas', 10),
                                              padx=10,
                                              pady=10)
        text_area.pack(fill=tk.BOTH, expand=True)
        
        # Leer y mostrar contenido
        try:
            with open(filepath, 'r', encoding='latin-1') as f:
                content = f.read()
                # Limpiar HTML
                cleaned = re.sub(r'<.*?>', '', content)
                cleaned = re.sub(r'\s+', ' ', cleaned)
                text_area.insert('1.0', cleaned)
                text_area.config(state='disabled')
        except Exception as e:
            text_area.insert('1.0', f"Error al leer el documento: {e}")
            text_area.config(state='disabled')



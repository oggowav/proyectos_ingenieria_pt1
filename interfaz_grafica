def hash_function(key, size):
    """Implementa función hash DJB2"""
    hash_value = 5381
    for char in key:
        hash_value = ((hash_value << 5) + hash_value) + ord(char)
    return hash_value % size

def extract_words(text):
    """Extrae palabras del texto"""
    words = re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9\-]+", text)
    return words


class SearchEngine:
    """Motor de búsqueda para documentos indexados"""
    
    def __init__(self, project_folder, html_folder):
        self.project_folder = project_folder
        self.html_folder = html_folder
        self.documents = {}
        self.dictionary = {}
        self.posting_list = []
        self.load_index()
    
    def load_index(self):
        """Carga el índice invertido desde los archivos"""
        # Cargar documents.txt
        documents_file = os.path.join(self.project_folder, "documents.txt")
        if os.path.exists(documents_file):
            with open(documents_file, 'r', encoding='utf-8') as f:
                for line in f:
                    parts = line.strip().split(' - ')
                    if len(parts) >= 3:
                        doc_id = int(parts[0])
                        filename = parts[1]
                        self.documents[doc_id] = filename
        
        # Cargar dictionary.txt
        dictionary_file = os.path.join(self.project_folder, "dictionary.txt")
        if os.path.exists(dictionary_file):
            with open(dictionary_file, 'r', encoding='utf-8') as f:
                for line in f:
                    # Formato: token: palabra | freq: N | docs: M | posting_pos: P
                    if 'token:' in line:
                        parts = line.strip().split('|')
                        token = parts[0].split(':')[1].strip()
                        freq = int(parts[1].split(':')[1].strip())
                        docs_count = int(parts[2].split(':')[1].strip())
                        posting_pos = int(parts[3].split(':')[1].strip())
                        
                        self.dictionary[token] = {
                            'freq': freq,
                            'docs': docs_count,
                            'posting_pos': posting_pos
                        }
        
        # Cargar posting.txt
        posting_file = os.path.join(self.project_folder, "posting.txt")
        if os.path.exists(posting_file):
            with open(posting_file, 'r', encoding='utf-8') as f:
                for line in f:
                    # Formato: idx: doc_id - weight
                    if ':' in line:
                        parts = line.strip().split(':')[1].strip().split(' - ')
                        if len(parts) == 2:
                            doc_id = int(parts[0])
                            weight = float(parts[1])
                            self.posting_list.append((doc_id, weight))
    
    def search_word(self, word):
        """Busca una palabra en el índice"""
        word = word.lower().strip()
        
        if not word:
            return None
        
        if word not in self.dictionary:
            return None
        
        info = self.dictionary[word]
        posting_pos = info['posting_pos']
        docs_count = info['docs']
        
        # Obtener documentos desde la lista de posting
        results = []
        for i in range(posting_pos, posting_pos + docs_count):
            if i < len(self.posting_list):
                doc_id, weight = self.posting_list[i]
                if doc_id in self.documents:
                    results.append({
                        'doc_id': doc_id,
                        'filename': self.documents[doc_id],
                        'weight': weight,
                        'relevance': weight * 100
                    })
        
        # Ordenar por relevancia
        results.sort(key=lambda x: x['relevance'], reverse=True)
        
        return {
            'word': word,
            'total_freq': info['freq'],
            'docs_count': docs_count,
            'results': results
        }
    
    def search_multiple_words(self, words):
        """Busca múltiples palabras y combina resultados"""
        word_list = [w.strip().lower() for w in words.split() if w.strip()]
        
        if not word_list:
            return None
        
        # Buscar cada palabra
        all_results = {}
        for word in word_list:
            result = self.search_word(word)
            if result:
                for doc in result['results']:
                    doc_id = doc['doc_id']
                    if doc_id not in all_results:
                        all_results[doc_id] = {
                            'doc_id': doc_id,
                            'filename': doc['filename'],
                            'relevance': 0,
                            'matched_words': []
                        }
                    all_results[doc_id]['relevance'] += doc['relevance']
                    all_results[doc_id]['matched_words'].append(word)
        
        # Convertir a lista y ordenar
        combined_results = list(all_results.values())
        combined_results.sort(key=lambda x: x['relevance'], reverse=True)
        
        return {
            'words': word_list,
            'total_results': len(combined_results),
            'results': combined_results
        }
    
    def get_document_preview(self, filename, max_chars=500):
        """Obtiene una vista previa del documento"""
        filepath = os.path.join(self.html_folder, filename)
        
        if not os.path.exists(filepath):
            return "Documento no encontrado"
        
        try:
            with open(filepath, 'r', encoding='latin-1') as f:
                content = f.read()
                # Limpiar HTML
                cleaned = re.sub(r'<.*?>', '', content)
                # Limpiar espacios múltiples
                cleaned = re.sub(r'\s+', ' ', cleaned)
                cleaned = cleaned.strip()
                
                if len(cleaned) > max_chars:
                    return cleaned[:max_chars] + "..."
                return cleaned
        except Exception as e:
            return f"Error al leer documento: {e}"


